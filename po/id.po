msgid "Updated translations"
msgstr "Terjemahan diperbarui"

#: data/settings-daemon.metainfo.xml.in:77
msgid "Progress indicators were added to the system update"
msgstr "Indikator kemajuan ditambahkan ke pembaruan sistem"

#: data/settings-daemon.metainfo.xml.in:78
msgid "Get correct total size for system updates"
msgstr "Dapatkan ukuran total yang benar untuk pembaruan sistem"

#: data/settings-daemon.metainfo.xml.in:90
#: data/settings-daemon.metainfo.xml.in:106
#: data/settings-daemon.metainfo.xml.in:122
#: data/settings-daemon.metainfo.xml.in:151
#: data/settings-daemon.metainfo.xml.in:170
msgid "New features:"
msgstr "Fitur baru:"

#: data/settings-daemon.metainfo.xml.in:92
msgid "Don't automatically download updates on a metered network"
msgstr "Jangan unduh pembaruan secara otomatis pada jaringan berkuota"

#: data/settings-daemon.metainfo.xml.in:108
msgid "Option to restart or shutdown without installing updates"
msgstr "Opsi untuk memulai ulang atau mematikan tanpa memasang pembaruan"

#: data/settings-daemon.metainfo.xml.in:124
msgid "Handle operating system updates, including automatic updates"
msgstr "Tangani pembaruan sistem operasi, termasuk pembaruan otomatis"

#: data/settings-daemon.metainfo.xml.in:125
msgid "Handle driver installation"
msgstr "Tangani pemasangan driver"

#: data/settings-daemon.metainfo.xml.in:126
msgid "Move the AccentColorManager from the window manager to here"
msgstr "Pindahkan AccentColorManager dari manajer jendela ke sini"

#: data/settings-daemon.metainfo.xml.in:153
msgid "Provide accent colors on the settings portal"
msgstr "Sediakan warna aksen pada portal pengaturan"

#: data/settings-daemon.metainfo.xml.in:154
msgid ""
"Sync font, mouse, keyboard, nightlight, and some accessibility settings to "
"the Login &amp; Lock screen"
msgstr ""
"Sinkronkan huruf, tetikus, papan ketik, cahaya malam, dan beberapa "
"pengaturan aksesibilitas ke layar Masuk &amp; Kunci"

#: data/settings-daemon.metainfo.xml.in:172
msgid "Add First day of the week setting"
msgstr "Tambah pengaturan Hari pertama dalam sepekan"

#: data/settings-daemon.metainfo.xml.in:173
msgid "Add left-handed mouse click setting"
msgstr "Tambah pengaturan klik tetikus kidal"

#: data/settings-daemon.metainfo.xml.in:174
msgid "Don't Housekeep Downloads if it's also Home"
msgstr "Jangan Bersihkan Unduhan jika juga merupakan Folder Beranda"

