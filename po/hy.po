#: data/settings-daemon.metainfo.xml.in:91
msgid "Progress indicators were added to the system update"
msgstr "Համակարգի թարմացմանը ավելացվել են առաջընթացի ցուցիչներ"

#: data/settings-daemon.metainfo.xml.in:92
msgid "Get correct total size for system updates"
msgstr "Ուղղվել է համակարգի թարմացումների ընդհանուր չափի ստացումը"

#: data/settings-daemon.metainfo.xml.in:104
